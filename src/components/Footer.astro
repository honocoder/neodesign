---
import { offers, site } from "@lib/site";
---

<footer class="footer">
  <div class="wrap footer-grid">
    <div>
      <a class="logo" href="/">NeoDesign</a>
      <p class="lead">{site.tagline}. Sites, maintenance, automatisation et conseil pour les professionnels.</p>
    </div>
    <div>
      <h2>Pages</h2>
      <ul>
        <li><a href="/services">Services</a></li>
        <li><a href="/projets">Réalisations</a></li>
        <li><a href="/tarifs">Tarifs</a></li>
        <li><a href="/a-propos">À propos</a></li>
        <li><a href="/contact">Contact</a></li>
      </ul>
    </div>
    <div>
      <h2>Offres</h2>
      <ul>
        {offers.map((offer) => (
          <li><a href={offer.href}>{offer.name}</a></li>
        ))}
      </ul>
    </div>
    <div>
      <h2>Contact</h2>
      <ul>
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        <li><a href={site.phoneHref}>{site.phoneDisplay}</a></li>
        <li>{site.city}, à distance ou sur place</li>
        <li><a href="/mentions-legales">Mentions légales</a></li>
        <li><a href="/politique-de-confidentialité">Politique de confidentialité</a></li>
      </ul>
    </div>
  </div>
  <div class="wrap legal-line">
    <p>© NeoDesign</p>
    <p>Prestations réservées aux professionnels. TVA non applicable, art. 293 B du CGI.</p>
  </div>
</footer>
