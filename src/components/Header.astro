---
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const active = (href: string) => (href === "/" ? path === "/" : path === href || path.startsWith(`${href}/`));
const projectsActive = path === "/projets" || path.startsWith("/projects/");

const links = [
  { href: "/services", label: "Services", current: active("/services") },
  { href: "/projets", label: "Réalisations", current: projectsActive },
  { href: "/tarifs", label: "Tarifs", current: active("/tarifs") },
  { href: "/a-propos", label: "À propos", current: active("/a-propos") },
];
---

<a class="skip" href="#contenu">Aller au contenu</a>
<p class="spine">NeoDesign · près d'Amiens</p>
<header class="header">
  <a class="logo" href="/" aria-label="NeoDesign, accueil">
    <svg viewBox="0 0 32 32" aria-hidden="true">
      <rect width="32" height="32" rx="8" fill="#0d3326"></rect>
      <path d="M16 26c0 0-7-6-6-13 1-6 6-8 6-8s4-1 6 5c2 7-6 16-6 16z" fill="#d7f07a"></path>
    </svg>
    NeoDesign
  </a>
  <details class="nav">
    <summary>
      <span class="when-closed">Menu</span>
      <span class="when-open">Fermer</span>
    </summary>
    <nav class="nav-panel" aria-label="Navigation principale">
      {
        links.map((link) => (
          <a href={link.href} aria-current={link.current ? "page" : undefined} class:list={{ "is-active": link.current }}>
            {link.label}
          </a>
        ))
      }
      <a class="btn btn-lime" href="/contact">Contact</a>
    </nav>
  </details>
</header>
