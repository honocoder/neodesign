---
import Base from "@layouts/Base.astro";
import PageHero from "@components/PageHero.astro";
import Close from "@components/Close.astro";
import ServiceSections from "@components/ServiceSections.astro";
import { getOffer, maintenanceTiers, priceLabel } from "@lib/site";

const offer = getOffer("maintenance");
---

<Base
  title="Maintenance et sécurité de site | NeoDesign"
  description="Trois forfaits de maintenance : Essentiel 60 €, Sérénité 80 €, Pro 100 € par mois. Mises à jour, sauvegardes et surveillance."
  jsonLd={{
    "@context": "https://schema.org",
    "@type": "Service",
    name: offer.name,
    serviceType: "Maintenance de site web",
    provider: { "@type": "ProfessionalService", name: "NeoDesign" },
    areaServed: "Amiens",
    offers: {
      "@type": "Offer",
      priceCurrency: "EUR",
      priceSpecification: {
        "@type": "PriceSpecification",
        minPrice: "60",
        priceCurrency: "EUR",
        unitText: "mois",
      },
      description: "À partir de 60 € par mois. TVA non applicable, art. 293 B du CGI.",
    },
  }}
>
  <PageHero
    eyebrow="02 · Maintenance"
    title="Le site reste à jour, sans y penser."
    lead="Mises à jour, sauvegardes et surveillance. Les forfaits Sérénité et Pro ajoutent du temps chaque mois pour faire évoluer le site, ou plus."
  >
    <p class="lead">{priceLabel(offer)}. TVA non applicable, art. 293 B du CGI.</p>
    <div class="actions">
      <a class="btn btn-lime" href={offer.contact}>Je veux un devis</a>
      <a class="btn btn-ghost" href="/tarifs#maintenance">Comparer les forfaits</a>
    </div>
  </PageHero>

  <ServiceSections
    glance={[
      { title: "À jour", text: "Les mises à jour du site sont suivies, sans que vous ayez à les lancer." },
      { title: "Sauvé", text: "Des sauvegardes pour pouvoir revenir en arrière si quelque chose casse." },
      { title: "Surveillé", text: "La disponibilité est surveillée : on voit si le site ne répond plus." },
    ]}
    steps={[
      { title: "Le site actuel", text: "On regarde ce qui est en place, et ce qui doit être surveillé." },
      { title: "Le forfait", text: "Essentiel, Sérénité ou Pro, écrit dans le devis avec le volume d'heures." },
      { title: "Chaque mois", text: "Les mises à jour et les sauvegardes, plus les heures prévues s'il y en a." },
    ]}
  >
    <div class="tier-block">
      <h2>Trois forfaits.</h2>
      <div class="tier-grid">
        {
          maintenanceTiers.map((tier) => (
            <article class="tier">
              <h3>{tier.name}</h3>
              <p class="price-figure">
                {tier.price}
                <span class="price-unit">{tier.unit}</span>
              </p>
              <ul class="checklist">
                {tier.points.map((point) => (
                  <li>{point}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
      <p class="note">
        Les 2 h de Sérénité portent sur le site. Les 5 h du forfait Pro peuvent servir au site, à un outil ou à une automatisation. Le détail est écrit dans le devis.
      </p>
    </div>
  </ServiceSections>
  <Close href={offer.contact} />
</Base>
