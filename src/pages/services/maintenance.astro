---
import Base from "@layouts/Base.astro";
import PageHero from "@components/PageHero.astro";
import Close from "@components/Close.astro";
import ServiceSections from "@components/ServiceSections.astro";
import {
  getOffer,
  maintenanceDescription,
  maintenanceNotes,
  maintenanceStructuredOffer,
  maintenanceTiers,
  priceLabel,
} from "@lib/site";

const offer = getOffer("maintenance");
---

<Base
  title="Maintenance et sécurité de site | NeoDesign"
  description={maintenanceDescription}
  jsonLd={{
    "@context": "https://schema.org",
    "@type": "Service",
    name: offer.name,
    serviceType: "Maintenance de site web",
    provider: { "@type": "ProfessionalService", name: "NeoDesign" },
    areaServed: "Amiens",
    offers: maintenanceStructuredOffer,
  }}
>
  <PageHero
    eyebrow="02 · Maintenance"
    title="Le site reste à jour, sans y penser."
    lead="On s'occupe des mises à jour, de la sécurité, de la surveillance et des sauvegardes. Chaque forfait inclut des heures de modification."
  >
    <p class="lead">{priceLabel(offer)}. TVA non applicable, art. 293 B du CGI.</p>
    <div class="actions">
      <a class="btn btn-lime" href={offer.contact}>Je veux un devis</a>
      <a class="btn btn-ghost" href="/tarifs#maintenance">Comparer les forfaits</a>
    </div>
  </PageHero>

  <ServiceSections
    glance={[
      { title: "À jour", text: "On met à jour le CMS, les extensions et les thèmes, et on surveille la disponibilité du site." },
      { title: "Sauvé", text: "On sauvegarde le site et sa base de données chaque semaine avec Essentiel et Sérénité, chaque jour avec Pro." },
      { title: "Pris en charge", text: "Sous 72 h ouvrées avec Essentiel, 48 h avec Sérénité et 24 h en priorité avec Pro." },
    ]}
    steps={[
      { title: "Le site actuel", text: "On regarde ce qui est en place, et ce qui doit être surveillé." },
      { title: "Le forfait", text: "Essentiel, Sérénité ou Pro. Les heures de modification ne se cumulent pas d'un mois sur l'autre." },
      { title: "Chaque mois", text: "On assure les mises à jour, la sécurité, la surveillance et les sauvegardes. Vous pouvez utiliser les heures de modification prévues dans votre forfait." },
    ]}
  >
    <div class="tier-block">
      <h2>Trois forfaits.</h2>
      <div class="tier-grid">
        {
          maintenanceTiers.map((tier) => (
            <article class="tier">
              <h3>{tier.name}</h3>
              <p class="price-figure">
                {tier.price}
                <span class="price-unit">{tier.unit}</span>
              </p>
              <ul class="checklist">
                {tier.points.map((point) => (
                  <li>{point}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
      <ul class="checklist">
        {maintenanceNotes.map((note) => <li>{note}</li>)}
      </ul>
      <p class="note">Prix finaux. TVA non applicable, art. 293 B du CGI.</p>
    </div>
  </ServiceSections>
  <Close href={offer.contact} />
</Base>
