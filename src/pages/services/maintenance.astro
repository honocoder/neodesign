---
import Base from "@layouts/Base.astro";
import PageHero from "@components/PageHero.astro";
import Close from "@components/Close.astro";
import ServiceSections from "@components/ServiceSections.astro";
import { getOffer, maintenanceNotes, maintenanceTiers, priceLabel } from "@lib/site";

const offer = getOffer("maintenance");
---

<Base
  title="Maintenance et sécurité de site | NeoDesign"
  description="Trois forfaits de maintenance : Essentiel 60 €, Sérénité 120 €, Pro 240 € par mois. Mises à jour, sécurité, surveillance et sauvegardes. Prix finaux, TVA non applicable."
  jsonLd={{
    "@context": "https://schema.org",
    "@type": "Service",
    name: offer.name,
    serviceType: "Maintenance de site web",
    provider: { "@type": "ProfessionalService", name: "NeoDesign" },
    areaServed: "Amiens",
    offers: {
      "@type": "Offer",
      priceCurrency: "EUR",
      priceSpecification: {
        "@type": "PriceSpecification",
        minPrice: "60",
        priceCurrency: "EUR",
        unitText: "mois",
      },
      description:
        "À partir de 60 € par mois. Essentiel 60 €, Sérénité 120 €, Pro 240 €. Prix finaux, TVA non applicable, art. 293 B du CGI.",
    },
  }}
>
  <PageHero
    eyebrow="02 · Maintenance"
    title="Le site reste à jour, sans y penser."
    lead="Mises à jour, sécurité, surveillance de disponibilité et sauvegardes. Sérénité et Pro ajoutent du temps de modification, avec une prise en charge plus courte."
  >
    <p class="lead">{priceLabel(offer)}. TVA non applicable, art. 293 B du CGI.</p>
    <div class="actions">
      <a class="btn btn-lime" href={offer.contact}>Je veux un devis</a>
      <a class="btn btn-ghost" href="/tarifs#maintenance">Comparer les forfaits</a>
    </div>
  </PageHero>

  <ServiceSections
    glance={[
      { title: "À jour", text: "Mises à jour et sécurité, sans que vous ayez à les lancer." },
      { title: "Sauvé", text: "Sauvegardes hebdomadaires, quotidiennes avec le forfait Pro." },
      { title: "Pris en charge", text: "Sous 72 h, 48 h ou 24 h ouvrées, selon le forfait." },
    ]}
    steps={[
      { title: "Le site actuel", text: "On regarde ce qui est en place, et ce qui doit être surveillé." },
      { title: "Le forfait", text: "Essentiel, Sérénité ou Pro. Les heures de modification ne se cumulent pas d'un mois sur l'autre." },
      { title: "Chaque mois", text: "Les mises à jour, la sécurité et les sauvegardes, plus les heures prévues s'il y en a." },
    ]}
  >
    <div class="tier-block">
      <h2>Trois forfaits.</h2>
      <div class="tier-grid">
        {
          maintenanceTiers.map((tier) => (
            <article class="tier">
              <h3>{tier.name}</h3>
              <p class="price-figure">
                {tier.price}
                <span class="price-unit">{tier.unit}</span>
              </p>
              <ul class="checklist">
                {tier.points.map((point) => (
                  <li>{point}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
      <ul class="checklist">
        {maintenanceNotes.map((note) => <li>{note}</li>)}
      </ul>
      <p class="note">Prix finaux. TVA non applicable, art. 293 B du CGI.</p>
    </div>
  </ServiceSections>
  <Close href={offer.contact} />
</Base>
