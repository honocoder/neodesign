---
import Base from "@layouts/Base.astro";
import PageHero from "@components/PageHero.astro";
import Close from "@components/Close.astro";
import { offers, priceLabel } from "@lib/site";
---

<Base
  title="Services | NeoDesign"
  description="Quatre services pour les professionnels : site vitrine, maintenance, automatisation n8n et conseil technique. Développeur web freelance près d'Amiens."
>
  <PageHero
    eyebrow="Services"
    title="Quatre façons de vous aider."
    lead="Sites, maintenance, automatisation et conseil. Les projets e-commerce, applications web ou mobiles se traitent sur devis, en dehors de ces quatre offres."
  />
  <section class="section">
    <div class="wrap menu-list">
      {
        offers.map((offer) => (
          <a href={offer.href}>
            <span class="idx">{offer.index}</span>
            <h2>{offer.name}</h2>
            <p class="sum">{offer.summary}</p>
            <p class="cost">{priceLabel(offer)}</p>
          </a>
        ))
      }
    </div>
  </section>
  <Close />
</Base>
