---
import Base from "@layouts/Base.astro";
import PageHero from "@components/PageHero.astro";
import Close from "@components/Close.astro";
import { mobileService, offers, priceLabel } from "@lib/site";
---

<Base
  title="Services | NeoDesign"
  description="Sites web, maintenance, automatisation n8n, conseil technique et applications mobiles. Développeur freelance près d'Amiens."
>
  <PageHero
    eyebrow="Services"
    title="Ce que je peux faire pour vous."
    lead="Sites web, y compris les boutiques, maintenance, automatisation, conseil, et applications mobiles."
  />
  <section class="section">
    <div class="wrap menu-list">
      {
        offers.map((offer) => (
          <a href={offer.href}>
            <span class="idx">{offer.index}</span>
            <h2>{offer.name}</h2>
            <p class="sum">{offer.summary}</p>
            <p class="cost">{priceLabel(offer)}</p>
          </a>
        ))
      }
      <a href={mobileService.href}>
        <span class="idx">05</span>
        <h2>{mobileService.name}</h2>
        <p class="sum">{mobileService.summary}</p>
        <p class="cost">Sur devis</p>
      </a>
    </div>
  </section>
  <Close />
</Base>
