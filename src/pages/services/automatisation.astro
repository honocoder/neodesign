---
import Base from "@layouts/Base.astro";
import PageHero from "@components/PageHero.astro";
import Close from "@components/Close.astro";
import { getOffer, priceLabel } from "@lib/site";

const offer = getOffer("automatisation");
---

<Base
  title="Automatisation et IA avec n8n | NeoDesign"
  description="Formulaires, devis, relances et réservations qui s'enchaînent avec n8n. À partir de 500 €, pour TPE, associations et startups."
  jsonLd={{
    "@context": "https://schema.org",
    "@type": "Service",
    name: offer.name,
    serviceType: "Automatisation n8n",
    provider: { "@type": "ProfessionalService", name: "NeoDesign" },
    areaServed: "Amiens",
    offers: {
      "@type": "Offer",
      priceCurrency: "EUR",
      priceSpecification: {
        "@type": "PriceSpecification",
        minPrice: "500",
        priceCurrency: "EUR",
      },
      description: "À partir de 500 €. TVA non applicable, art. 293 B du CGI.",
    },
  }}
>
  <PageHero
    eyebrow="03 · Automatisation"
    title="Vos outils se parlent enfin."
    lead="Quand les mêmes informations sont recopiées à la main d'un formulaire vers un tableau, un e-mail ou un agenda, un scénario peut le faire à votre place."
  >
    <p class="lead">{priceLabel(offer)}. TVA non applicable, art. 293 B du CGI.</p>
    <div class="actions">
      <a class="btn btn-lime" href={offer.contact}>Je veux un devis</a>
    </div>
  </PageHero>

  <section class="section">
    <div class="wrap split">
      <div>
        <h2>Exemples</h2>
        <ul class="checklist">
          <li>Un formulaire de devis qui remplit un tableau et envoie un e-mail.</li>
          <li>Des rappels avant un rendez-vous.</li>
          <li>La relance des devis restés sans réponse.</li>
          <li>Un tri de messages avec une IA, seulement là où elle est utile.</li>
        </ul>
      </div>
      <div>
        <h2>Ce qui est inclus</h2>
        <ul class="checklist">
          <li>Cadrage du besoin</li>
          <li>Mise en place du scénario</li>
          <li>Tests</li>
          <li>Une documentation simple</li>
          <li>Un mois de suivi</li>
        </ul>
        <p class="note">L'hébergement et le suivi des automatisations, au-delà de ce mois, sont chiffrés sur devis.</p>
      </div>
    </div>
  </section>
  <Close href={offer.contact} />
</Base>
