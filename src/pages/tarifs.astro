---
import Base from "@layouts/Base.astro";
import PageHero from "@components/PageHero.astro";
import Close from "@components/Close.astro";
import {
  getOffer,
  maintenanceTiers,
  offers,
  priceLabel,
  vitrineIncludes,
  vitrineOptions,
} from "@lib/site";

const vitrine = getOffer("site-vitrine");
const maintenance = getOffer("maintenance");
const auto = getOffer("automatisation");
const conseil = getOffer("conseil");
---

<Base
  title="Tarifs | NeoDesign"
  description="Sites vitrines à partir de 1 200 €, maintenance à partir de 50 € par mois, automatisation à partir de 500 €, conseil à partir de 250 € la demi-journée. Prix finaux, TVA non applicable."
>
  <PageHero
    eyebrow="Tarifs"
    title="Des prix pour se situer."
    lead="Chaque projet fait l'objet d'un devis gratuit et détaillé. Offres réservées aux professionnels. TVA non applicable, art. 293 B du CGI : les prix indiqués sont les prix que vous payez."
  />

  <section class="section">
    <div class="wrap" style="display: grid; gap: 1.25rem;">
      <article class="plain-card">
        <p class="kicker" style="color: var(--leaf); font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; font-size: 0.78rem;">01</p>
        <h2>{vitrine.name}</h2>
        <p>{vitrine.summary}</p>
        <p class="price-figure">{priceLabel(vitrine)}</p>
        <ul class="checklist">
          {vitrineIncludes.map((item) => <li>{item}</li>)}
        </ul>
        <p class="note">Options : {vitrineOptions.join(", ").toLowerCase()}.</p>
        <div class="actions">
          <a class="btn" href={vitrine.contact}>Je veux un devis</a>
        </div>
      </article>

      <article class="plain-card" id="maintenance">
        <p class="kicker" style="color: var(--leaf); font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; font-size: 0.78rem;">02</p>
        <h2>{maintenance.name}</h2>
        <p>{maintenance.summary}</p>
        <p class="price-figure">{priceLabel(maintenance)}</p>
        <p class="note">
          Seul Essentiel est chiffré. Les paliers Sérénité et Pro sont des pistes : montants à valider, non contractuels tant qu'ils ne sont pas arrêtés.
        </p>
        <div class="tier-grid">
          {
            maintenanceTiers.map((tier) => (
              <article class:list={["tier", { pending: tier.pending }]}>
                <h3>{tier.name}</h3>
                {tier.pending && <p class="badge badge-quiet">À valider</p>}
                <p><strong>{tier.price}</strong></p>
                <ul class="checklist">
                  {tier.points.map((point) => (
                    <li>{point}</li>
                  ))}
                </ul>
              </article>
            ))
          }
        </div>
        <div class="actions">
          <a class="btn" href={maintenance.contact}>Je veux un devis</a>
        </div>
      </article>

      <article class="plain-card">
        <p class="kicker" style="color: var(--leaf); font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; font-size: 0.78rem;">03</p>
        <h2>{auto.name}</h2>
        <p>{auto.summary}</p>
        <p class="price-figure">{priceLabel(auto)}</p>
        <ul class="checklist">
          <li>Cadrage, mise en place, tests, documentation</li>
          <li>Un mois de suivi</li>
          <li>Hébergement et suivi ensuite : sur devis</li>
        </ul>
        <div class="actions">
          <a class="btn" href={auto.contact}>Je veux un devis</a>
        </div>
      </article>

      <article class="plain-card">
        <p class="kicker" style="color: var(--leaf); font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; font-size: 0.78rem;">04</p>
        <h2>{conseil.name}</h2>
        <p>{conseil.summary}</p>
        <p class="price-figure">{priceLabel(conseil)}</p>
        <p class="note">Audit d'outils au forfait : sur devis, le montant n'est pas fixé ici.</p>
        <div class="actions">
          <a class="btn" href={conseil.contact}>Réserver un échange</a>
        </div>
      </article>

      <article class="plain-card" id="sur-mesure">
        <h2>Projets sur mesure</h2>
        <p>E-commerce, application web ou application mobile : sur devis.</p>
        <div class="actions">
          <a class="btn btn-line" href="/contact?offre=autre">En parler</a>
        </div>
      </article>

      <p class="note">
        TVA non applicable, art. 293 B du CGI. Prestations réservées aux professionnels.
        Les quatre offres : {offers.map((offer) => offer.name).join(", ")}.
      </p>
    </div>
  </section>
  <Close />
</Base>
