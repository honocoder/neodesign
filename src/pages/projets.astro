---
import Base from "@layouts/Base.astro";
import PageHero from "@components/PageHero.astro";
import Close from "@components/Close.astro";
import { getCollection } from "astro:content";

const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
---

<Base
  title="Réalisations | NeoDesign"
  description="Sites web, application mobile, centre d'aide et outils réalisés par NeoDesign pour des professionnels."
>
  <PageHero
    eyebrow="Réalisations"
    title="Des projets, pas un catalogue."
    lead="Une sélection pour se faire une idée. Chaque projet est unique, et nous décidons ensemble de la solution, du design comme de la technique."
  />
  <section class="section">
    <div class="wrap project-grid">
      {
        projects.map((project, index) => (
          <a class="project-card" href={`/projects/${project.id}`}>
            <div class="frame">
              <img
                src={project.data.image.src}
                alt={project.data.image.alt}
                width={project.data.image.width}
                height={project.data.image.height}
                loading={index < 2 ? "eager" : "lazy"}
                decoding="async"
              />
            </div>
            <p class="kicker">{project.data.category}</p>
            <h2>{project.data.title}</h2>
            <p>{project.data.snippet}</p>
          </a>
        ))
      }
    </div>
  </section>
  <Close />
</Base>
