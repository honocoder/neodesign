---
import Base from "@layouts/Base.astro";
import PageHero from "@components/PageHero.astro";
import Close from "@components/Close.astro";
import { iaTpe, offers, site, tools } from "@lib/site";
---

<Base
  title="À propos de NeoDesign : sites web et automatisation près d'Amiens | NeoDesign"
  description="NeoDesign, studio web près d'Amiens : sites, maintenance, automatisation et IA, conseil technique et applications mobiles, pour les professionnels."
>
  <PageHero
    eyebrow="À propos"
    title="Un studio web, un seul interlocuteur."
    lead="NeoDesign est un studio web basé près d'Amiens, dans la Somme. Sites, maintenance, automatisation et applications mobiles : on s'occupe de tout, de la première discussion à la mise en ligne, avec un seul interlocuteur."
  />

  <section class="section">
    <div class="wrap split">
      <div class="reveal">
        <p class="eyebrow">Ce que l'on fait pour vous</p>
        <h2>Des solutions qui tiennent dans le temps.</h2>
        <p class="note">
          NeoDesign travaille exclusivement avec des professionnels : TPE, artisans, professions libérales, associations et startups, à Amiens, dans la Somme ou à distance.
        </p>
      </div>
      <ul class="steps reveal">
        {
          offers.map((offer) => (
            <li>
              <a href={offer.href}><strong>{offer.name}</strong></a>
              <span>{offer.summary}</span>
            </li>
          ))
        }
        <li>
          <a href={iaTpe.href}><strong>{iaTpe.name}</strong></a>
          <span>{iaTpe.summary}</span>
        </li>
      </ul>
    </div>
  </section>

  <section class="section" style="padding-top: 0;">
    <div class="wrap split">
      <div class="reveal">
        <p class="eyebrow">Façon de travailler</p>
        <h2>Clair dès le premier échange.</h2>
        <ul class="checklist">
          <li>Un seul interlocuteur, du premier appel à la mise en ligne.</li>
          <li>Un devis clair avant de commencer, sans jargon.</li>
          <li>Des outils simples que vous gardez en main : pas de dépendance artificielle.</li>
          <li>Une réponse sous {site.responseTime}.</li>
        </ul>
      </div>
      <div class="reveal">
        <p class="eyebrow">Outils</p>
        <h2>La boîte à outils.</h2>
        <p>Ceux que l'on utilise vraiment, selon le projet.</p>
        <ul class="tools">
          {tools.map((tool) => <li>{tool}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <Close href="/contact" title="Parlons de votre projet" />
</Base>
