---
import { getCollection, render } from "astro:content";
import Base from "@layouts/Base.astro";
import PageHero from "@components/PageHero.astro";
import Close from "@components/Close.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const offer = entry.data.category === "Site vitrine" ? "site-vitrine" : "autre";
---

<Base title={`${entry.data.title} | NeoDesign`} description={entry.data.snippet}>
  <PageHero eyebrow={entry.data.category} title={entry.data.title} lead={entry.data.snippet}>
    <div class="meta-row">
      {entry.data.tags.map((tag) => <span class="tag">{tag}</span>)}
    </div>
    {
      entry.data.url && (
        <div class="actions">
          <a class="btn btn-lime" href={entry.data.url} target="_blank" rel="noopener noreferrer">
            Voir le site
          </a>
        </div>
      )
    }
  </PageHero>
  <article class="prose-wrap">
    <div class="wrap">
      <figure class="cover">
        <img
          src={entry.data.image.src}
          alt={entry.data.image.alt}
          width={entry.data.image.width}
          height={entry.data.image.height}
          loading="eager"
          decoding="async"
        />
      </figure>
      <div class="prose prose-lg">
        <Content />
      </div>
      <div class="actions">
        <a class="btn btn-line" href="/projets">Retour aux réalisations</a>
      </div>
    </div>
  </article>
  <Close href={`/contact?offre=${offer}`} title="Un projet dans le même esprit ?" />
</Base>
