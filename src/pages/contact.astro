---
import Base from "@layouts/Base.astro";
import PageHero from "@components/PageHero.astro";
import ContactForm from "@components/ContactForm.astro";
import { offerChoices, site } from "@lib/site";

const offre = Astro.url.searchParams.get("offre") ?? "";
const selected = offerChoices.some((choice) => choice.id === offre) ? offre : "";
---

<Base
  title="Contact | NeoDesign"
  description="Décrivez votre projet à Jimy Marletta, développeur freelance près d'Amiens. Réponse sous 48 h ouvrées."
>
  <PageHero
    eyebrow="Contact"
    title="Dites-moi ce dont vous avez besoin."
    lead={`Décrivez votre besoin en quelques lignes : je vous réponds sous ${site.responseTime} avec une première estimation ou quelques questions. Vous préférez parler ? Appelez-moi au ${site.phoneDisplay}.`}
  />
  <div class="wrap contact-grid">
    <aside class="contact-aside">
      <p><a href={site.phoneHref}>{site.phoneDisplay}</a></p>
      <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
      <p>{site.city}, France. Sur place dans la Somme, ou à distance.</p>
      <p class="note">Prestations réservées aux professionnels.</p>
    </aside>
    <ContactForm selected={selected} />
  </div>
</Base>
