# Variables lues uniquement par le serveur. Ne pas les préfixer par PUBLIC_.
# À renseigner dans l'environnement Vercel (Production, et Preview si besoin).

# URL complète du webhook n8n, en https.
N8N_WEBHOOK_URL=

# Facultatif. Valeur exacte attendue par Header Auth dans n8n.
# Si n8n attend « Bearer … », inclure ce préfixe dans la valeur.
N8N_WEBHOOK_SECRET=

# Facultatif. Nom de l'en-tête secret. Défaut : Authorization,
# uniquement lorsque N8N_WEBHOOK_SECRET est défini.
N8N_WEBHOOK_AUTH_HEADER=
