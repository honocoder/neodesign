# Variables lues uniquement par le serveur. Ne pas les préfixer par PUBLIC_.
# Les saisir dans Vercel. Ne pas y mettre la clé du webhook dans ce fichier.

# URL https du webhook n8n.
N8N_WEBHOOK_URL=https://n8n.jimsvault.tech/webhook/neodesign-contact

# Clé enregistrée dans n8n. Elle est envoyée dans X-NeoDesign-Webhook-Token.
# La coller uniquement dans les variables d'environnement Vercel.
N8N_WEBHOOK_SECRET=
